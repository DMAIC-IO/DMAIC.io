{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.qprovement.com/schemas/module-help.schema.json",
  "title": "Handbuch eines Moduls (resources/i18n/help.<lang>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["sections"],
  "properties": {
    "$schema": { "$ref": "common.schema.json#/$defs/schemaRef" },
    "sections": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/section" } }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "blocks"],
      "properties": {
        "title": { "$ref": "common.schema.json#/$defs/text" },
        "blocks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/block" } }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/contentBlock" },
        { "$ref": "#/$defs/definitionBlock" },
        { "$ref": "#/$defs/itemsBlock" },
        { "$ref": "#/$defs/tableBlock" }
      ]
    },
    "contentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "enum": ["paragraph", "heading", "decision", "pitfall", "result", "scenario"] },
        "content": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "definitionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "term", "content"],
      "properties": {
        "type": { "const": "definition" },
        "term": { "$ref": "common.schema.json#/$defs/text" },
        "content": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "itemsBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "enum": ["list", "steps"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/text" } }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "headers": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/text" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
