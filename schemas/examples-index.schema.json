{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.qprovement.com/schemas/examples-index.schema.json",
  "title": "Beispielkatalog der alten Form (examples/index.json, bis Teilprojekt G) — ohne Szenarien",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "examples"],
  "properties": {
    "$schema": { "$ref": "common.schema.json#/$defs/schemaRef" },
    "version": { "$ref": "common.schema.json#/$defs/text" },
    "examples": { "type": "array", "items": { "$ref": "#/$defs/indexEntry" } }
  },
  "$defs": {
    "indexEntry": {
      "type": "object",
      "$ref": "example-entry.schema.json#/$defs/entry",
      "required": ["modules"],
      "properties": {
        "modules": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      },
      "unevaluatedProperties": false
    }
  }
}
