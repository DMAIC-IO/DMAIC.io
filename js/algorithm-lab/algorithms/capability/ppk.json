{
  "id": "ppk",
  "name": {
    "de": "Langzeit-Prozessfähigkeit {{term:ppk|Ppk}}",
    "en": "Overall Process Capability Ppk"
  },
  "category": "capability",
  "subcategory": null,
  "status": "validated",
  "version": "1.1.0",

  "description": {
    "short": {
      "de": "Langzeit-Prozessfähigkeit auf Basis der Gesamtstreuung (Stichproben-Standardabweichung, n − 1).",
      "en": "Overall process capability based on total variation (sample standard deviation, n − 1)."
    },
    "long": {
      "de": "Pp und Ppk sind die 'Long-Term'-Gegenstücke zu Cp und Cpk. Sie verwenden die Gesamt-Standardabweichung aller Werte (n − 1), die auch Drift und Variation zwischen Untergruppen enthält — Cp/Cpk verwenden dagegen nur σ innerhalb (MR̄/d2 bzw. gepoolte s/c4). Bei einem Prozess ohne Drift liegen Pp ≈ Cp und Ppk ≈ Cpk dicht beieinander; liegt Pp deutlich unter Cp, ist der Prozess über die Zeit nicht stabil. Ppk = min(PPU, PPL) und bestraft wie Cpk außermittige Prozesse. Ppk ≥ 1,33 gilt allgemein als fähig.",
      "en": "Pp and Ppk are the 'long-term' counterparts to Cp and Cpk. They use the overall standard deviation of all values (n − 1), which includes drift and between-subgroup variation — Cp/Cpk use σ within only (MR̄/d2 or pooled s/c4). For a process without drift, Pp ≈ Cp and Ppk ≈ Cpk; if Pp falls clearly below Cp, the process is not stable over time. Ppk = min(PPU, PPL) and, like Cpk, penalises off-center processes. Ppk ≥ 1.33 is generally considered capable."
    }
  },

  "documentation": {
    "formulas": [
      {
        "label": "Pp",
        "latex": "P_p = \\frac{USL - LSL}{6s}",
        "description": {
          "de": "Langzeit-Prozessfähigkeit (s = Gesamt-Standardabweichung, n − 1)",
          "en": "Overall process capability (s = overall standard deviation, n − 1)"
        }
      },
      {
        "label": "Ppk",
        "latex": "P_{pk} = \\min\\!\\left(\\frac{USL - \\bar{x}}{3s},\\; \\frac{\\bar{x} - LSL}{3s}\\right)",
        "description": {
          "de": "Minimum aus oberem und unterem Langzeit-Fähigkeitsindex",
          "en": "Minimum of upper and lower overall capability indices"
        }
      },
      {
        "label": "PPU",
        "latex": "P_{PU} = \\frac{USL - \\bar{x}}{3s}",
        "description": {
          "de": "Oberer Langzeit-Fähigkeitsindex",
          "en": "Upper overall capability index"
        }
      },
      {
        "label": "PPL",
        "latex": "P_{PL} = \\frac{\\bar{x} - LSL}{3s}",
        "description": {
          "de": "Unterer Langzeit-Fähigkeitsindex",
          "en": "Lower overall capability index"
        }
      },
      {
        "label": "CI(Ppk)",
        "latex": "CI(P_{pk}) = P_{pk} \\pm z_{1-\\alpha/2} \\cdot \\sqrt{\\frac{1}{9n} + \\frac{P_{pk}^2}{2(n-1)}}",
        "description": {
          "de": "Approximatives Konfidenzintervall für Ppk (Kushler-Hurley-Normalapproximation)",
          "en": "Approximate confidence interval for Ppk (Kushler-Hurley normal approximation)"
        }
      }
    ],
    "assumptions": [
      {
        "de": "Daten sind annähernd normalverteilt",
        "en": "Data is approximately normally distributed"
      },
      {
        "de": "Datensatz repräsentiert den Langzeit-Prozess (enthält Untergruppen-Variation)",
        "en": "Dataset represents the long-term process (contains between-subgroup variation)"
      },
      {
        "de": "Messwerte sind unabhängig",
        "en": "Measurements are independent"
      }
    ],
    "limitations": [
      {
        "de": "Pp (zweiseitig) nur bei LSL und USL gleichzeitig definiert",
        "en": "Pp (two-sided) only defined with both LSL and USL"
      },
      {
        "de": "Divergenz zwischen Pp/Ppk und Cp/Cpk ist ein Indikator für Instabilität — nicht ignorieren",
        "en": "Divergence between Pp/Ppk and Cp/Cpk is an indicator of instability — do not ignore it"
      },
      {
        "de": "Ausreichender Stichprobenumfang erforderlich (n ≥ 100 für belastbare Langzeit-Aussage)",
        "en": "Requires sufficient sample size (n ≥ 100 for a robust long-term statement)"
      }
    ],
    "references": [
      {
        "source": "Montgomery, Introduction to Statistical Quality Control, 8th Ed.",
        "chapter": "Chapter 7"
      },
      {
        "source": "AIAG — Statistical Process Control (SPC) Reference Manual, 2nd Edition"
      },
      {
        "source": "Kushler, R. & Hurley, P. (1992), Confidence Bounds for Capability Indices, Journal of Quality Technology, 24(4), 188–195"
      }
    ],
    "minitab_equivalent": "Stat > Quality Tools > Capability Analysis > Normal (Overall)"
  },

  "source": {
    "function_name": "capabilityAnalyze",
    "file_path": "js/engines/process-capability-engine.js",
    "signature": {
      "parameters": [
        {
          "name": "data",
          "type": "number[]",
          "required": true,
          "description": {
            "de": "Array von Messwerten",
            "en": "Array of measurement values"
          }
        },
        {
          "name": "lsl",
          "type": "number",
          "required": true,
          "description": {
            "de": "Untere Spezifikationsgrenze",
            "en": "Lower specification limit"
          }
        },
        {
          "name": "usl",
          "type": "number",
          "required": true,
          "description": {
            "de": "Obere Spezifikationsgrenze",
            "en": "Upper specification limit"
          }
        },
        {
          "name": "confidence",
          "type": "number",
          "required": false,
          "description": {
            "de": "Konfidenzniveau (Default 0.95)",
            "en": "Confidence level (default 0.95)"
          }
        },
        {
          "name": "subgroup_size",
          "type": "number",
          "required": false,
          "description": {
            "de": "Untergruppengröße (Default 1 = Einzelwerte, σ innerhalb aus MR̄/d2; ≥ 2 = aufeinanderfolgende Untergruppen, gepoolte s/c4)",
            "en": "Subgroup size (default 1 = individuals, σ within from MR̄/d2; ≥ 2 = consecutive subgroups, pooled s/c4)"
          }
        }
      ],
      "returns": {
        "type": "object",
        "properties": {
          "pp": {
            "type": "number|null",
            "description": {
              "de": "Langzeit-Prozessfähigkeit",
              "en": "Overall process capability"
            }
          },
          "ppk": {
            "type": "number|null",
            "description": {
              "de": "Langzeit-Prozessfähigkeitsindex (min(ppu, ppl))",
              "en": "Overall process capability index (min(ppu, ppl))"
            }
          },
          "ppu": {
            "type": "number|null",
            "description": {
              "de": "Oberer Langzeit-Fähigkeitsindex",
              "en": "Upper overall capability index"
            }
          },
          "ppl": {
            "type": "number|null",
            "description": {
              "de": "Unterer Langzeit-Fähigkeitsindex",
              "en": "Lower overall capability index"
            }
          },
          "PpCI": {
            "type": "[number,number]|null",
            "description": {
              "de": "Exaktes χ²-Konfidenzintervall für Pp",
              "en": "Exact χ² confidence interval for Pp"
            }
          },
          "PpkCI": {
            "type": "[number,number]|null",
            "description": {
              "de": "Kushler-Hurley-Konfidenzintervall für Ppk",
              "en": "Kushler-Hurley confidence interval for Ppk"
            }
          },
          "mean": {
            "type": "number",
            "description": {
              "de": "Stichprobenmittelwert",
              "en": "Sample mean"
            }
          },
          "sigma": {
            "type": "number",
            "description": {
              "de": "Populations-Standardabweichung (ddof = 0)",
              "en": "Population standard deviation (ddof = 0)"
            }
          },
          "stddev": {
            "type": "number",
            "description": {
              "de": "Standardabweichung gesamt (n−1) — Basis für Pp/Ppk",
              "en": "Overall standard deviation (n−1) — basis for Pp/Ppk"
            }
          },
          "n": {
            "type": "number",
            "description": {
              "de": "Stichprobengröße",
              "en": "Sample size"
            }
          },
          "sigma_within": {
            "type": "number",
            "description": {
              "de": "σ innerhalb (MR̄/d2 bzw. gepoolte s/c4) — Basis für Cp/Cpk",
              "en": "σ within (MR̄/d2 or pooled s/c4) — basis for Cp/Cpk"
            }
          }
        }
      }
    },
    "code_snippet": null
  },

