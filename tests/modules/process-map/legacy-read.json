        "substeps": [],
        "expanded": false,
        "loop": null
      },
      {
        "id": "s2",
        "title": "Rotorblätter falten",
        "description": "Bergfalte (⌃) mittig bei x = 47 mm; beide Rotorblätter (je 47 mm breit, Gesamtspannweite 94 mm) gegenläufig falten. Rotorlänge L (Faktorstufe 8/6/4 cm) ist der aktuelle Blockwert. ~15 s.",
        "valueType": "va",
        "inputs": [
          {
            "id": "i2a",
            "name": "Zugeschnittener Flyer-Rohling"
          },
          {
            "id": "i2b",
